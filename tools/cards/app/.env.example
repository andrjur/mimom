PORT=3000
# Общий платный ключ по умолчанию отключён.
ENABLE_SHARED_AI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Дополнительные доверенные origin, через запятую. Например http://localhost:11434 для локального Ollama.
AI_ALLOWED_ORIGINS=
# Новый токен из BotFather. Не добавляйте его в Git или клиентский код.
TELEGRAM_BOT_TOKEN=
