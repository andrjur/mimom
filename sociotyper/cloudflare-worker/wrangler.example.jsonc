{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "indikov-typist-api",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "indikov.ru/api/typist/*", "zone_name": "indikov.ru" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "KNYAZEV_BASE_URL": "https://knyazevai.work/v1",
    "KNYAZEV_MODEL": "minimax-2.7",
    "PROBE_MODEL": "minimax-2.7",
    "KNYAZEV_MIX_MODELS": "minimax-2.7,deepseek-v4-flash,kimi-2.6",
    "FINAL_MODEL": "minimax-2.7",
    "PROBE_REQUESTS_PER_MINUTE": "10",
    "QUESTION_MODEL": "minimax-2.7",
    "STORE_DEBUG_PAYLOADS": "true",
    "ALLOW_CUSTOM_BYOK": "true",
    "LOG_PROMPTS": "true",
    "DEBUG_RETENTION_DAYS": "7",
    "NOTIFY_TO": "a9507652513@gmail.com",
    "NOTIFY_FROM": "typist@indikov.ru"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "indikov-typist", "database_id": "PASTE_D1_ID_HERE" }],
  "r2_buckets": [{ "binding": "DEBUG_BUCKET", "bucket_name": "indikov-typist-debug" }],
  "send_email": [{ "name": "NOTIFY_EMAIL", "destination_address": "a9507652513@gmail.com" }]
}
